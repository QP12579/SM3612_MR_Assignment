# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# 自動備份與崩潰日誌（有些舊版 UE 沒被 Saved/* 乾淨阻擋）
Autosaves/
Backup/
CrashReportClient/

# Unreal下載的過期或暫存安裝包（非常佔空間）
FeaturePacks/
Samples/

# 機器學習 / 虛擬網格 (Nanite) 等新版 UE5 產生的本地快照
.p4ignore
DerivedDataCache/
DataDrivenCV/

# 外部 IDE（如 Rider 或 VS Code）自動產生的巨量快取
.idea/
.vscode/
*.Visual Studio.*
CompileSanityTest/

# 常見的本地作業系統垃圾檔案（防止 Mac/Windows 互相干擾）
Thumbs.db
.DS_Store

# 打包輸出的成品（有些自訂打包路徑會漏掉）
/ArchivedBuilds/
/Windows/
/Mac/
/Linux/
